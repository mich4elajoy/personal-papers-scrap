{
  "overrides": {
    "braces": "^3.0.3",
    "postcss-selector-parser": "^7.1.6"
  },
  "name": "personal-papers",
  "version": "1.0.0",
  "description": "Personal Archive",
  "main": "index.js",
  "scripts": {
    "css-compile": "sass --load-path=node_modules --style expanded --source-map --embed-sources scss:css",
    "css-prefix": "postcss --config postcss.config.js --replace \"css/*.css\" \"!css/*.min.css\"",
    "build": "npm-run-all --sequential css-compile css-prefix",
    "watch": "nodemon --watch scss/ --ext scss --exec \"npm run build\"",
    "serve": "sirv --port 8080 --dev .",
    "start": "npm-run-all build --parallel watch serve",
    "lint": "stylelint \"scss/**/*.scss\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mich4elajoy/personal-papers.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mich4elajoy/personal-papers/issues"
  },
  "homepage": "https://github.com/mich4elajoy/personal-papers#readme",
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.30",
    "postcss-cli": "^12.0.0",
    "sass": "^1.105.2",
    "sirv-cli": "^3.0.1",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
